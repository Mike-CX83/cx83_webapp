# Copy to /opt/cx83-webapp-prod/.env on the server. Do not commit the filled file.
# POSTGRES_PASSWORD is read by deploy/production/compose.yml.
# DATABASE_URL must use the production Postgres container name, not the hostname postgres.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cx83:PASSWORD@cx83-webapp-prod-postgres:5432/cx83_webapp_production
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=https://cx83labs.com
CRON_SECRET=
PREVIEW_SECRET=
CHATBOT_ENABLED=true
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=800
PAYLOAD_MCP_ENABLED=false
PAYLOAD_DB_PUSH=false
NODE_ENV=production
