# Copy to /opt/cx83-webapp/.env on the server. Do not commit the filled file.
# POSTGRES_PASSWORD is read by deploy/staging/compose.yml.
# DATABASE_URL must use the compose service name postgres, not a public address.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cx83:PASSWORD@cx83-webapp-postgres:5432/cx83_webapp_staging
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=https://staging.cx83labs.com
CRON_SECRET=
PREVIEW_SECRET=
CHATBOT_ENABLED=true
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=800
PAYLOAD_MCP_ENABLED=true
PAYLOAD_MCP_API_KEY=
PAYLOAD_DB_PUSH=false
CX83_REPO_ROOT=/repo
# Protected development staging is never indexable or customer-released.
CX83_PUBLIC_LAUNCH_APPROVED=false
# Run 3: optional, separately authorized Google Workspace send API integration.
# Verified CX83 Labs public contact alias. OAuth grant may remain on the existing
# Workspace account; the alias must have verified send-as and inbound delivery.
CX83_INQUIRY_TO=hello@cx83labs.com
CX83_GMAIL_CLIENT_ID=
CX83_GMAIL_CLIENT_SECRET=
CX83_GMAIL_REFRESH_TOKEN=
# Dedicated random 32+ character bearer for restricted manual dispatch.
CX83_INQUIRY_DISPATCH_SECRET=
NODE_ENV=production
