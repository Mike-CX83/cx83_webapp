# PostgreSQL connection string for this development database.
# Do not point this at a production database.
# Example: postgresql://USER:PASSWORD@HOST:5432/cx83_webapp_dev?sslmode=require
DATABASE_URL=

# Used to encrypt JWT tokens. Generate a long random string. Do not commit the real value.
PAYLOAD_SECRET=

# Public site origin. No trailing slash.
# The installed Payload template reads NEXT_PUBLIC_SERVER_URL. SITE_URL is accepted as documentation
# for the same origin if you prefer that name in hosting config, but the app reads the variable below.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate scheduled jobs. Optional during local development.
CRON_SECRET=

# Used to validate preview requests.
PREVIEW_SECRET=

# Visitor assistant. CHATBOT_ENABLED=false hides the chat launcher.
# The website still runs when the selected provider key is missing. Chat then returns a configuration error.
CHATBOT_ENABLED=true

# openrouter, google, or openai. There is no fallback to another provider.
AI_PROVIDER=openrouter

# OpenRouter key from the CX83 account. Server-side only. Never expose this to the browser.
# openrouter/free routes to a free model and does not require billing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Gemini Developer API key from Google AI Studio. Server-side only. Never expose this to the browser.
# Free-tier prompts can be used to improve Google products. Send public site knowledge and ordinary chat only.
GOOGLE_GENERATIVE_AI_API_KEY=

# Checked against Gemini API pricing on 2026-10-06.
# gemini-2.5-flash-lite is still listed and free on the standard tier, but a new CX83 key on 2026-10-06
# was told that model is no longer available to new users. gemini-3.5-flash-lite is the replacement.
# Its standard free tier also lists input and output as free of charge.
GOOGLE_MODEL=gemini-3.5-flash-lite

# Used only when AI_PROVIDER=openai.
# Checked against OpenAI model docs on 2026-10-06: gpt-6-luna, $0.10 / 1M input tokens, $0.50 / 1M output tokens.
OPENAI_MODEL=gpt-6-luna

# Server-side only. Never expose this to the browser.
OPENAI_API_KEY=

# Caps a single assistant reply for either provider. The assistant settings global can also set this when the env var is absent.
OPENAI_MAX_OUTPUT_TOKENS=800

# Local Payload MCP. The plugin is disabled in production unless this is true.
# Do not expose the dev server or this endpoint through a public tunnel.
PAYLOAD_MCP_ENABLED=true
