# PostgreSQL connection string for this development database.
# Do not point this at a production database.
# Example: postgresql://USER:PASSWORD@HOST:5432/cx83_webapp_dev?sslmode=require
DATABASE_URL=

# Used to encrypt JWT tokens. Generate a long random string. Do not commit the real value.
PAYLOAD_SECRET=

# Public site origin. No trailing slash.
# The installed Payload template reads NEXT_PUBLIC_SERVER_URL. SITE_URL is accepted as documentation
# for the same origin if you prefer that name in hosting config, but the app reads the variable below.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate scheduled jobs. Optional during local development.
CRON_SECRET=

# Used to validate preview requests.
PREVIEW_SECRET=

# Visitor assistant. Missing OpenAI credentials do not stop the website.
# CHATBOT_ENABLED=false hides the chat launcher.
CHATBOT_ENABLED=true

# First provider. Add another provider later in src/ai/model.ts.
AI_PROVIDER=openai

# Inexpensive current OpenAI model for this low-traffic site.
# Checked against OpenAI model docs on 2026-10-06: gpt-6-luna, $0.10 / 1M input tokens, $0.50 / 1M output tokens.
OPENAI_MODEL=gpt-6-luna

# Server-side only. Never expose this to the browser.
OPENAI_API_KEY=

# Caps a single assistant reply. The assistant settings global can also set this when the env var is absent.
OPENAI_MAX_OUTPUT_TOKENS=800

# Local Payload MCP. The plugin is disabled in production unless this is true.
# Do not expose the dev server or this endpoint through a public tunnel.
PAYLOAD_MCP_ENABLED=true
